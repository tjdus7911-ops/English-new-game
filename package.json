{
  "name": "english-village",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audio": "python3 scripts/generate_audio.py",
    "validate:content": "vitest run tests/content",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "art:mansion": "python3 scripts/mansion-art/import_figma_a.py && python3 scripts/mansion-art/bake_scene.py"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "@capacitor/screen-orientation": "^7.0.4",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1",
    "@capacitor/android": "^7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
